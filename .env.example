# ---------------------------------------------------------------- Superadmin
# Control-Plane-Konto für /admin auf der Marketingseite.
# Ohne diese Werte gilt in der Entwicklung der Testzugang
# admin@gleistrix.de / Gleistrix!2026. In Produktion ist ohne sie kein Login
# möglich – das ist Absicht.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Signiert das Session-Cookie. Mindestens 16 Zeichen, in Produktion Pflicht.
# Erzeugen mit: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --------------------------------------------------------- Gleistrix-Support
# Getrenntes Konto für den Zugriff auf Kundeninstanzen. Bewusst NICHT identisch
# mit ADMIN_EMAIL/ADMIN_PASSWORD: Eine Session unter /admin allein darf keine
# Kundendaten öffnen.
GLEISTRIX_SUPPORT_EMAIL=support@gleistrix.de
GLEISTRIX_SUPPORT_PASSWORD=

# Signiert die Support-Token und authentifiziert jeden Aufruf an die App. Muss
# dort identisch gesetzt sein (die Variable heißt auch in der App
# SERVICE_SHARED_SECRET). Mindestens 32 Zeichen.
# Erzeugen mit: openssl rand -hex 32
SERVICE_SHARED_SECRET=

# ------------------------------------------------------- Schnittstelle zur App
# Beide Aufrufe gehen an GLEISTRIX_APP_URL (siehe unten) und tragen
# "Authorization: Bearer <SERVICE_SHARED_SECRET>":
#
#   POST /api/internal/tenants  legt einen Mandanten an. Kopf "Idempotency-Key"
#     trägt die Kauf-ID; derselbe Schlüssel darf keinen zweiten Mandanten
#     erzeugen. Antwort 201 {tenantId, einladungsLink}, bei Wiederholung 200
#     mit demselben Rumpf. Zugangsdaten werden NICHT übertragen – die App
#     verbindet sich mit ihrem eigenen Datenbankbenutzer und wählt die
#     Kundendatenbank über den mitgeschickten Namen.
#
# Die Gegenrichtung geht an DIESE Website und traegt dasselbe Geheimnis:
#
#   POST /api/internal/addons  meldet, dass ein Nutzer in der App ein Add-on
#     freigeschaltet hat. Kopf "Idempotency-Key" traegt die Vorgangskennung der
#     App; derselbe Schluessel erzeugt keine zweite Buchung. Rumpf
#     {kennung, module: [...], mengen?: {modul: anzahl}} - OHNE Preis: den
#     rechnet die Website aus ihrer freigegebenen Preisliste. Antwort 201
#     {kaufId, monatlich}, bei Wiederholung 200 mit demselben Rumpf.
#
#   POST /api/internal/demo  schaltet Demoversionen frei und entzieht sie.
#     Erwartet {action:"grant"|"revoke", email, company, days}, antwortet mit
#     {url, expiresAt} bzw. im Fehlerfall {error} und passendem Statuscode.

# -------------------------------------------------------------------- MongoDB
# Datenbank für Adminbereich und Website (Control-Plane). Ohne diese Werte
# schreibt der Adminbereich in die lokale Datei ./.data/admin-store.json –
# das reicht für die Entwicklung, aber NICHT für den Betrieb auf Vercel:
# dort ist das Dateisystem schreibgeschützt.
#
# Adresse ohne Schema, mit Port:
MONGODB_HOST=5.9.22.170:57017
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Datenbank der Control-Plane. Die Mandanten bekommen je eine eigene Datenbank
# auf demselben Server (gleistrix_<kennung>, siehe lib/admin/tenant.ts).
MONGODB_DATABASE=gleistrix_control

# Datenbank, in der der Benutzer angelegt ist – bei MongoDB üblicherweise admin.
MONGODB_AUTH_SOURCE=admin

# Auf "true" setzen, sobald der Server TLS anbietet. Dringend empfohlen:
# ohne TLS gehen alle Daten unverschlüsselt über das öffentliche Internet.
MONGODB_TLS=false

# Alternative: fertige Verbindungszeichenfolge. Ist sie gesetzt, gilt nur sie
# und die Einzelwerte oben werden ignoriert. Sonderzeichen im Passwort müssen
# dann selbst kodiert werden.
MONGODB_URI=

# ------------------------------------------------------------------ Mandanten
# Basisdomain der Gleistrix-Umgebung.
NEXT_PUBLIC_TENANT_ROOT_DOMAIN=gleistrix.de

# Adresse der mandantenfähigen App – für alle Kunden dieselbe.
# Ohne Angabe gilt https://app.<NEXT_PUBLIC_TENANT_ROOT_DOMAIN>.
GLEISTRIX_APP_URL=

# Cluster-Admin-Verbindung: legt je Mandant eine eigene Datenbank
# (gleistrix_<kennung>) und einen darauf beschränkten Benutzer (svc_<kennung>) an.
MONGODB_ADMIN_URI=

# MinIO: ein Bucket je Mandant (gleistrix-<kennung>) mit eigener Policy.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Optional: Ablageort des lokalen Admin-Speichers (Standard: ./.data)
GLEISTRIX_DATA_DIR=

# ------------------------------------------------------------------ Mailversand
# SMTP-Zugang für Benachrichtigungen über neue Anfragen und für den
# Broschürenversand aus dem Adminbereich. Fehlen HOST, USER oder PASS, wird
# NICHT versendet – Anfragen landen trotzdem in der Datenbank, und die
# Broschürenseite zeigt statt des Sendeknopfes einen Hinweis.
SMTP_HOST=
# Standard 587 (STARTTLS). 465 schaltet auf implizites TLS um.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Absender der Systemmails (Standard: noreply@gleistrix.com)
SMTP_FROM=

# Postfach, das die Anfragen von der Website erhält (Standard: info@gleistrix.com)
CONTACT_EMAIL=

# ------------------------------------------------------------------- Broschüre
# Im Repository liegt keine PDF. Entweder eine Datei vom Server anhängen …
BROCHURE_FILE_PATH=
# … oder einen Downloadlink in den Text setzen. Ist beides gesetzt, gilt die
# Datei. Fehlen beide, geht nur das Anschreiben raus.
BROCHURE_FILE_URL=
